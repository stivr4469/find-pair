version: '3.8'

services:
  nginx2:
    container_name: nginx2
    image: nginx:latest
    ports:
      - "8280:80"
    volumes:
      - ./vhost.conf:/etc/nginx/conf.d/default.conf
      - ./www:/var/www/public_html
    networks:
      - php_my_network
    depends_on:
      - php2
      - mysql2

  php2:
    container_name: php2
    build: ./images/php
    volumes:
      - ./www:/var/www/public_html
    networks:
      - php_my_network
    depends_on:
      - mysql2

  mysql2:
    container_name: mysql2
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: root_password
      MYSQL_DATABASE: database_name
      MYSQL_USER: user
      MYSQL_PASSWORD: user_password
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - php_my_network

  phpmyadmin2:
    container_name: phpmyadmin2
    image: phpmyadmin/phpmyadmin:latest
    environment:
      PMA_HOST: mysql2
      PMA_USER: user
      PMA_PASSWORD: user_password
    ports:
      - "1500:80"
    depends_on:
      - mysql2
    networks:
      - php_my_network

networks:
  php_my_network:

volumes:
  mysql_data:

